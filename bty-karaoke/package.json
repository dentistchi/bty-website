    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:connection": "node scripts/verify-connection.mjs",
    "seed:room": "node scripts/seed-room.mjs",
    "create:room": "node scripts/create-room.mjs",
    "retire:room": "node scripts/retire-room.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "make:qr": "node scripts/make-qr.mjs",
    "admin:setup": "node scripts/admin-setup-qr.mjs",
    "gate:b23:seed": "node scripts/gate-b23-seed.mjs",
