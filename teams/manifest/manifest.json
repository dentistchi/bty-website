{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.14",
  "id": "374ec662-0deb-4e0b-8514-e38a035a349e",
  "developer": {
    "name": "BTY Training Center",
    "websiteUrl": "https://arena.btydaily.com",
    "privacyUrl": "https://arena.btydaily.com/en/privacy",
    "termsOfUseUrl": "https://arena.btydaily.com/en/terms"
  },
  "name": {
    "short": "BTY",
    "full": "BTY Training Center"
  },
  "description": {
    "short": "Save messages privately or track announcement acknowledgment and responses.",
    "full": "Save a Teams message to your Today for later, or track explicit acknowledgment or written responses from a fixed audience. BTY records actions in BTY, not Teams channel read receipts."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline-s1-v112.png"
  },
  "accentColor": "#0B1F3A",
  "bots": [
    {
      "botId": "820f231b-9dbb-4c84-94c5-65bc43d35d91",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [
    {
      "botId": "820f231b-9dbb-4c84-94c5-65bc43d35d91",
      "commands": [
        {
          "id": "saveToBty",
          "type": "action",
          "title": "Save",
          "description": "Save this message to BTY so you don't lose it.",
          "context": [
            "message"
          ],
          "fetchTask": true
        },
        {
          "id": "trackWithBty",
          "type": "action",
          "title": "Track announcement",
          "description": "Track acknowledgment or written responses from selected recipients.",
          "context": [
            "message"
          ],
          "fetchTask": true
        }
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "btyHome",
      "name": "BTY",
      "contentUrl": "https://arena.btydaily.com/teams",
      "websiteUrl": "https://arena.btydaily.com",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "conversations",
      "scopes": [
        "personal"
      ]
    }
  ],
  "supportsChannelFeatures": "tier1",
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "arena.btydaily.com"
  ],
  "webApplicationInfo": {
    "id": "820f231b-9dbb-4c84-94c5-65bc43d35d91",
    "resource": "api://arena.btydaily.com/botid-820f231b-9dbb-4c84-94c5-65bc43d35d91"
  },
  "localizationInfo": {
    "defaultLanguageTag": "en",
    "additionalLanguages": [
      {
        "languageTag": "ko",
        "file": "ko.json"
      }
    ]
  }
}
